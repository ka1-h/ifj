import ifj26.*

def factorial(n: Int): Int =
    var result = 1
    var i: Int = n
    while i > 1 do
        result = result * i
        i = i - 1
    result

def sign(x: Int): Int =
    if x < 0 then
        return 0 - 1
    else
        if x == 0 then
            return 0
        else
            return 1

@main def main(): Unit =
    val n = readInt()
    print(factorial(n))
    print("\n")
    var k = 0 - 2
    while k <= 2 do
        print(sign(k))
        print(" ")
        k = k + 1
    print("\n")
    print(if n > 3 then "velke\n" else "male\n")
    if n == 5 then print("pat\n")
    if n != 5 then
        print("nie pat\n")
    else if n > 4 then
        print("viac ako 4\n")